+def vertical_rc_toward(current: list[float] | None, target: list[float] | None, max_vertical_rc: float) -> float:
+    if current is None or target is None:
+        return 0.0
+    error = float(target[1]) - float(current[1])
+    if abs(error) < 0.08:
