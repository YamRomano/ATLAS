+def clamp_float(value: Any, default: float, lo: float, hi: float) -> float:
+    try:
+        out = float(value)
+    except (TypeError, ValueError):
+        out = default
+    return max(lo, min(hi, out))
+
+
+def vector3(value: Any) -> list[float] | None:
+    if not isinstance(value, (list, tuple)) or len(value) < 3:
+        return None
+    try:
+        out = [float(value[0]), float(value[1]), float(value[2])]
+    except (TypeError, ValueError):
+        return None
+    if not all(math.isfinite(v) and abs(v) < 1e9 for v in out):
+        return None
+    return out
+
+
+def dot3(a: list[float], b: list[float]) -> float:
+    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+
+
+def sub3(a: list[float], b: list[float]) -> list[float]:
+    return [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+
+
+def normalize_xz(vec: list[float] | None) -> list[float] | None:
+    if not vec:
+        return None
+    n = math.hypot(vec[0], vec[2])
+    if n < 1e-9 or not math.isfinite(n):
+        return None
+    return [vec[0] / n, 0.0, vec[2] / n]
+
+
+def rotate_xz(vec: list[float] | None, radians: float) -> list[float] | None:
+    base = normalize_xz(vec)
+    if base is None:
+        return None
+    c = math.cos(radians)
+    s = math.sin(radians)
+    return normalize_xz([base[0] * c - base[2] * s, 0.0, base[0] * s + base[2] * c])
+
+
+def room_transform_pose(pose: dict[str, Any], room_transform: dict[str, Any] | None) -> dict[str, Any]:
+    """Fill rcenter/rheading using the same room frame sent by the browser."""
+    out = dict(pose)
+    if vector3(out.get("rcenter")) and vector3(out.get("rheading")):
+        return out
+    if not isinstance(room_transform, dict):
+        return out
+    origin = vector3(room_transform.get("origin"))
+    axes = room_transform.get("axes") if isinstance(room_transform.get("axes"), dict) else {}
+    axis_x = vector3(axes.get("x"))
+    axis_y = vector3(axes.get("y"))
+    axis_z = vector3(axes.get("z"))
+    if not origin or not axis_x or not axis_y or not axis_z:
+        return out
+
+    center = vector3(out.get("center"))
+    if center and not vector3(out.get("rcenter")):
+        d = sub3(center, origin)
+        out["rcenter"] = [dot3(d, axis_x), dot3(d, axis_y), dot3(d, axis_z)]
+
+    if not vector3(out.get("rheading")):
+        R = out.get("R")
+        if isinstance(R, list) and len(R) >= 3 and isinstance(R[2], list) and len(R[2]) >= 3:
+            try:
+                raw_forward = [float(R[2][0]), float(R[2][1]), float(R[2][2])]
+                f = [dot3(raw_forward, axis_x), dot3(raw_forward, axis_y), dot3(raw_forward, axis_z)]
+                if abs(f[0]) + abs(f[2]) > 1e-9:
+                    yaw_offset = clamp_float(room_transform.get("rotation_yaw_offset"), 0.0, -1000.0, 1000.0)
+                    yaw = math.atan2(f[0], f[2]) + yaw_offset
+                    out["rheading"] = [math.sin(yaw), 0.0, math.cos(yaw)]
+            except (TypeError, ValueError):
+                pass
+    return out
+
